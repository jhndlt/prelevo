# À copier dans la console Clever Cloud. Ne rien committer de rempli.
# Générer la paire : npm run generate-vapid
# La clé privée ne va nulle part ailleurs. La clé publique sera recopiée plus tard
# dans app/config.js (vapidPublicKey), dans une autre modification.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.com

# Déjà utilisés par prelevo-api si Supabase est branché. Réutiliser les mêmes noms.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret de la tâche planifiée. Une valeur longue, différente des clés VAPID.
CRON_SECRET=
